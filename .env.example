# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Bybit ---
# Genera las API keys en https://testnet.bybit.com (modo prueba) o https://www.bybit.com (real)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = usa testnet de Bybit (dinero simulado). Ponlo en false SOLO cuando hayas validado la estrategia.
BYBIT_TESTNET=true

# --- Webhook de TradingView ---
# Secreto compartido que TradingView debe incluir en el cuerpo de cada alerta (campo "secret").
# Genera uno fuerte, ej: openssl rand -hex 32
TRADINGVIEW_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Mapeo de ticker de TradingView -> símbolo ccxt/Bybit, en JSON. TradingView manda algo como
# "BTCUSDT" o "BTCUSDT.P"; Bybit vía ccxt espera "BTC/USDT:USDT" (perpetuo lineal).
# Agrega aquí cada símbolo que vayas a operar.
TRADINGVIEW_SYMBOL_MAP={"BTCUSDT.P":"BTC/USDT:USDT","ETHUSDT.P":"ETH/USDT:USDT"}

# --- Telegram (notificaciones) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gestión de riesgo ---
# % del balance disponible que se arriesga por operación (ej: 1 = 1%)
RISK_PER_TRADE_PCT=1
# Máximo de posiciones abiertas simultáneas
MAX_OPEN_POSITIONS=3
# % de pérdida diaria acumulada que activa el kill switch automáticamente
MAX_DAILY_LOSS_PCT=5

# --- Base de datos ---
DATABASE_PATH=./data/trading-bot.sqlite

# --- Estrategia contrarian (funding rate + RSI) ---
# Deshabilitada por defecto: es una fuente de señales generada por el propio bot
# (no viene de TradingView), actívala solo después de entender cómo opera (ver README).
CONTRARIAN_ENABLED=false
# Símbolos ccxt separados por coma, ej: BTC/USDT:USDT,ETH/USDT:USDT
CONTRARIAN_SYMBOLS=
CONTRARIAN_TIMEFRAME=15m
CONTRARIAN_CHECK_INTERVAL_MINUTES=15
# 0.0005 = 0.05% de funding rate, considerado "extremo" en perpetuos de cripto
CONTRARIAN_FUNDING_RATE_THRESHOLD=0.0005
CONTRARIAN_RSI_OVERBOUGHT=75
CONTRARIAN_RSI_OVERSOLD=25

# --- Watcher de liquidaciones reales (dato real de Bybit, sin Coinglass) ---
# Solo registra y muestra en el dashboard; no ejecuta órdenes por sí solo.
LIQUIDATION_WATCH_ENABLED=false
# Símbolos ccxt separados por coma, ej: BTC/USDT:USDT,ETH/USDT:USDT
LIQUIDATION_WATCH_SYMBOLS=
